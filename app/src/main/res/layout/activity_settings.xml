<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_root"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PENGATURAN" android:textColor="@color/cyan" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Open-Meteo tidak memerlukan akun/API key. Masukkan koordinat manual atau gunakan GPS HP." android:textColor="@color/text_muted" android:textSize="11sp"/>
<EditText android:id="@+id/appTitle" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Judul aplikasi" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/>
<EditText android:id="@+id/crop" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Komoditas" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/>
<Spinner android:id="@+id/cultivation" android:layout_width="match_parent" android:layout_height="52dp"/><EditText android:id="@+id/latitude" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Latitude (-90..90)" android:inputType="numberDecimal|numberSigned" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><EditText android:id="@+id/longitude" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Longitude (-180..180)" android:inputType="numberDecimal|numberSigned" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><EditText android:id="@+id/elevation" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Elevasi mdpl (opsional)" android:inputType="numberDecimal|numberSigned" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><TextView android:id="@+id/useGps" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:gravity="center" android:text="GUNAKAN GPS HP" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold"/>
<EditText android:id="@+id/channel" android:layout_width="match_parent" android:layout_height="52dp" android:hint="ThingSpeak Channel ID" android:inputType="number" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"><EditText android:id="@+id/readKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="ThingSpeak Read API Key" android:inputType="textPassword" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><TextView android:id="@+id/toggleReadKey" android:layout_width="100dp" android:layout_height="match_parent" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/cyan"/></LinearLayout>
<EditText android:id="@+id/aiModel" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Model AI (default: gpt-6-luna)" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"><EditText android:id="@+id/aiKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="OpenAI API Key" android:inputType="textPassword" android:textColor="@color/text_main" android:hintTextColor="@color/text_muted"/><TextView android:id="@+id/toggleAiKey" android:layout_width="100dp" android:layout_height="match_parent" android:gravity="center" android:text="TAMPILKAN" android:textColor="@color/cyan"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><TextView android:id="@+id/saveSettings" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="SIMPAN" android:background="@drawable/bg_button" android:textColor="@color/navy_950" android:textStyle="bold"/><TextView android:id="@+id/cancelSettings" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="BATAL" android:background="@drawable/bg_edit" android:textColor="@color/text_main"/></LinearLayout></LinearLayout></ScrollView>